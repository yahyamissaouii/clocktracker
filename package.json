{
  "name": "clocktrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "^2",
    "@supabase/ssr": "^0.12",
    "drizzle-orm": "^0.45",
    "postgres": "^3.4",
    "zod": "^3.24",
    "date-fns": "^4",
    "@date-fns/tz": "^1",
    "@react-pdf/renderer": "^4",
    "lucide-react": "^0.513",
    "clsx": "^2",
    "tailwind-merge": "^3",
    "class-variance-authority": "^0.7",
    "sonner": "^2",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-label": "^2",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-avatar": "^1",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@radix-ui/react-alert-dialog": "^1",
    "@radix-ui/react-checkbox": "^1",
    "@radix-ui/react-switch": "^1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "vitest": "^3",
    "@vitejs/plugin-react": "^4"
  }
}
